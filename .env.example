# Copy this file to .env (or set these as real environment variables) and fill in real values.
# NEVER commit a file containing actual secrets.

# Supabase PostgreSQL connection
# Format: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# JWT signing secret - generate a long random string (32+ characters)
# Example generation: openssl rand -base64 32
JWT_SECRET=
